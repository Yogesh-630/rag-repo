PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/collegerag_ai
JWT_SECRET=super_secret_jwt_key_for_collegerag_ai_2025

# Supabase (PostgreSQL & Vector Store / Cloud Storage)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_DB_URL=postgresql://postgres:your-db-password@db.your-project-ref.supabase.co:5432/postgres

# Redis / BullMQ (Optional)
REDIS_HOST=localhost
REDIS_PORT=6379

# AI Providers (Optional - built-in smart fallback active if not provided)
OPENAI_API_KEY=
GEMINI_API_KEY=

# RAG Settings
SIMILARITY_THRESHOLD=0.70
TOP_K_CHUNKS=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150
